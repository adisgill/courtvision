# Copy to .env (which is gitignored) and fill in.
#
# Kaggle API token (starts with KGAT_). Create one at
# https://www.kaggle.com/settings -> API -> "Generate New Token".
# A legacy ~/.kaggle/kaggle.json also works; in that case leave this unset.
KAGGLE_API_TOKEN=

# Optional: override where raw files, parquet and the DuckDB file live.
# COURTVISION_DATA_DIR=data
